            for block in item_blocks[:20]:
                # Titel
                title_match = re.search(r'<title>([^<]+)</title>', block)
                title = title_match.group(1) if title_match else u''
                
                # MP3 URL aus enclosure
                enc_match = re.search(r'enclosure[^>]*url="([^"]+)"', block)
                mp3_url = enc_match.group(1) if enc_match else ''
                # XML entity decode
                if mp3_url:
                    mp3_url = mp3_url.replace('&amp;', '&')
                
                # Datum
                date_match = re.search(r'<pubDate>([^<]+)</pubDate>', block)
                date_str = ''
                if date_match:
                    try:
                        parts = date_match.group(1).split()
                        if len(parts) >= 4:
                            day = parts[1]
                            months = {'Jan':'01','Feb':'02','Mar':'03','Apr':'04','May':'05','Jun':'06',
                                      'Jul':'07','Aug':'08','Sep':'09','Oct':'10','Nov':'11','Dec':'12'}
                            mon = months.get(parts[2], '01')
                            date_str = "%s.%s." % (day, mon)
                    except:
                        pass
                
                # Prüfe ob heruntergeladen
                downloaded = False
                if title and os.path.exists(download_dir):
                    try:
                        safe_title = title.replace(u'/', u'-').replace(u':', u'-').replace(u'?', u'').replace(u'"', u'')
                        safe_title = safe_title.replace(u'ä', u'ae').replace(u'ö', u'oe').replace(u'ü', u'ue')
                        safe_title = safe_title.replace(u'Ä', u'Ae').replace(u'Ö', u'Oe').replace(u'Ü', u'Ue')
                        safe_title = safe_title.replace(u'ß', u'ss')
                        local_file = os.path.join(download_dir, safe_title + u".mp3")
                        if os.path.exists(local_file):
                            downloaded = True
                    except:
                        pass
                
                if title and mp3_url:
                    print u"RSS episode: %s -> %s" % (title[:30], mp3_url)
                    items.append({
                        'id': 0,
                        'title': title,
                        'date': date_str,
                        'url': mp3_url,
                        'downloaded': downloaded
                    })
            
            print u"Found %d episodes from RSS" % len(items)
            self._episodesJson = json.dumps(items)
            self.podcastEpisodesChanged.emit()
            
        except Exception as e:
            print u"Parse RSS error: %s" % e
            self._episodesJson = '[]'
            self.podcastEpisodesChanged.emit()
    
