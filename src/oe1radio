    def _handleOnDemand(self, data):
        """Parse on-demand broadcasts with correct field names"""
        try:
            response = json.loads(data)
            broadcasts = response.get('payload', [])
            
            items = []
            for b in broadcasts:
                startStr = b.get('start', '')
                timeStr = ''
                if startStr:
                    try:
                        # Parse ISO (UTC) und addiere 1h für Wien
                        start = datetime.strptime(startStr[:19], '%Y-%m-%dT%H:%M:%S')
                        start = start + timedelta(hours=1)  # UTC -> CET
                        timeStr = start.strftime('%H:%M')
                    except Exception as e:
                        print u"Time parse error: %s" % e
                
                # QML erwartet 'hasStream' und 'time'
                item = {
                    'id': b.get('id', 0),
                    'title': b.get('title', ''),
                    'subtitle': b.get('programTitle', '') or '',
                    'time': timeStr,
                    'duration': b.get('duration', 0) // 1000 // 60,
                    'hasStream': b.get('isOnDemand', False)
                }
                items.append(item)
            
            print u"Found %d on-demand broadcasts" % len(items)
            self._broadcastsJson = json.dumps(items)
            self.onDemandBroadcastsChanged.emit()
            
        except Exception as e:
            print u"Parse on-demand error: %s" % e
    
    @Slot(int)
    def getPlaybackUrl(self, broadcastId):
        """Get stream URL and start local HTTP proxy for streaming with seek support"""
        print u"Getting playback URL for broadcast: %d" % broadcastId
        
        # Prüfe zuerst ob lokale Datei existiert
        import os
        import glob
        download_dir = u"/home/user/MyDocs/Oe1"
        if os.path.exists(download_dir):
            # Suche nach Datei mit dieser ID
            pattern = os.path.join(download_dir, u"%d_*.mp3" % broadcastId)
            matches = glob.glob(pattern)
            if matches:
                local_file = matches[0]
                print u"Found local file: %s" % local_file
                self._playUrl = "file://" + local_file
                self._streamDuration = 0  # Wird vom Player erkannt
                self.playUrlChanged.emit()
                return
        
        # Stoppe vorherigen Download/Proxy
        self._stopProxy()
        
        def worker():
            try:
                # Hole Broadcast-Details mit streams
                url = "%s/broadcast/%d" % (API_OE1, broadcastId)
                data = self._fetchUrl(url)
                if data:
                    response = json.loads(data)
                    payload = response.get('payload', {})
                    streams = payload.get('streams', [])
                    
                    if streams:
                        stream = streams[0]
                        loopStreamId = stream.get('loopStreamId', '')
                        
                        if loopStreamId:
                            stream_url = "https://loopstream01.apa.at/?channel=oe1&shoutcast=0&id=%s" % loopStreamId
                            print u"Starting proxy for: %s" % loopStreamId
                            
                            # Hole Content-Length zuerst
                            content_length = self._getContentLength(stream_url)
                            
                            # Starte lokalen HTTP-Proxy mit korrekter Länge
                            proxy_port = self._startProxy(stream_url, content_length)
                            if proxy_port:
                                self._pending['playUrl'] = "http://127.0.0.1:%d/stream.mp3" % proxy_port
                                return
                    
                    print u"No streams found for broadcast %d" % broadcastId
                    self._pending['playUrl'] = ''
            except Exception as e:
                print u"Get playback URL error: %s" % e
                self._pending['playUrl'] = ''
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        def check():
            if 'playUrl' in self._pending:
                url = self._pending.pop('playUrl')
                if url:
                    self._playUrl = url
                    print u"Playing via proxy: %s" % self._playUrl
                    self.playUrlChanged.emit()
                else:
                    self._errorMsg = "Kein Stream verfügbar"
                    self.errorOccurred.emit()
            elif t.is_alive():
                QTimer.singleShot(200, check)
        
        QTimer.singleShot(200, check)
    
    def _getContentLengthAsync(self, url, callback):
        """Get content length asynchronously using QTimer polling"""
        import os
        import time
        
        # Temp-Datei für wget output
        tmp_file = "/tmp/oe1_spider_%d.txt" % int(time.time())
        
        # Starte wget --spider als Hintergrundprozess (non-blocking!)
        proc = subprocess.Popen(
            ['/opt/wunderw/bin/wget', '--spider', '-S', '--timeout=10', '--max-redirect=5', url],
            stdout=open('/dev/null', 'w'),
            stderr=open(tmp_file, 'w')
        )
        
        print u"[Async] wget --spider started, polling..."
        
        def check_spider():
            if proc.poll() is not None:
                # wget fertig
                content_length = None
                try:
                    if os.path.exists(tmp_file):
                        with open(tmp_file, 'r') as f:
                            for line in f:
                                line_lower = line.lower()
                                if 'content-length:' in line_lower:
                                    parts = line.split(':')
                                    if len(parts) > 1:
                                        try:
                                            cl = int(parts[1].strip().split()[0])
                                            if cl > 0:
                                                content_length = cl
                                        except:
                                            pass
                        os.remove(tmp_file)
                except Exception as e:
                    print u"[Async] Error reading spider output: %s" % e
                
                if content_length:
                    print u"[Async] Content-Length: %d bytes (%.1f MB)" % (content_length, content_length/1024.0/1024.0)
                else:
                    print u"[Async] No Content-Length, using 50MB fallback"
                    content_length = 50 * 1024 * 1024
                
                callback(content_length)
            else:
                # Noch nicht fertig, weiter pollen
                QTimer.singleShot(100, check_spider)
        
        QTimer.singleShot(100, check_spider)
    
    def _getContentLength(self, url):
        """Get content length - BLOCKING, only call from worker thread!"""
        content_length = None
        
        try:
            proc = subprocess.Popen(
                ['/opt/wunderw/bin/wget', '--spider', '-S', '--timeout=10', '--max-redirect=5', url],
                stdout=open('/dev/null', 'w'),
                stderr=subprocess.PIPE
            )
            _, stderr = proc.communicate()
            
            # Suche letzte Content-Length (case-insensitive, nach allen Redirects)
            for line in stderr.split('\n'):
                line_lower = line.lower()
                if 'content-length:' in line_lower:
                    # Split bei ':' um case-insensitiv zu sein
                    parts = line.split(':')
                    if len(parts) > 1:
                        try:
                            cl = int(parts[1].strip().split()[0])
                            if cl > 0:
                                content_length = cl
                        except:
                            pass
        except Exception as e:
            print u"wget --spider error: %s" % e
        
        if content_length:
            print u"Content-Length: %d bytes (%.1f MB)" % (content_length, content_length/1024.0/1024.0)
            return content_length
        
        # WICHTIG: Großer Fallback damit der Player nicht bei EOF verwirrt wird
        # Der Stream endet sauber wenn wget fertig ist
        print u"No Content-Length, using 500MB fallback (stream ends at EOF)"
        return 500 * 1024 * 1024
    
    def _startProxyForPodcast(self, url):
        """Start in-process proxy for podcast (same as 7-Tage)"""
        print u"Starting in-process podcast proxy for URL (len=%d): %s" % (len(url), url)
        
        def worker():
            try:
                # Hole Content-Length für Dauer-Berechnung
                content_length = self._getContentLength(url)
                if content_length:
                    duration_ms = int(content_length / 16.0)
                    print u"Podcast Content-Length: %d, duration: %d ms" % (content_length, duration_ms)
                else:
                    content_length = 50 * 1024 * 1024
                    duration_ms = 0
                
                # Nutze den gleichen Proxy wie 7-Tage
                port = self._startProxy(url, content_length)
                
                if port:
                    self._pending['podcastPort'] = port
                    self._pending['podcastDuration'] = duration_ms
                else:
                    self._pending['podcastPort'] = 0
                    self._pending['podcastDuration'] = 0
                    
            except Exception as e:
                print u"Podcast proxy error: %s" % e
                import traceback
                traceback.print_exc()
                self._pending['podcastPort'] = 0
                self._pending['podcastDuration'] = 0
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        def check():
            if 'podcastPort' in self._pending:
                port = self._pending.pop('podcastPort')
                duration = self._pending.pop('podcastDuration', 0)
                
                if port > 0:
                    self._streamDuration = duration
                    self._playUrl = "http://127.0.0.1:%d/stream.mp3" % port
                    print u"Playing podcast via in-process proxy port %d" % port
                    self.playUrlChanged.emit()
                else:
                    self._errorMsg = "Podcast-Proxy fehlgeschlagen"
                    self.errorOccurred.emit()
            elif t.is_alive():
                QTimer.singleShot(200, check)
        
        QTimer.singleShot(200, check)
    
    def _startProxy(self, upstream_url, content_length=None):
        """Start local HTTP proxy with file-backed seeking"""
        import socket
        import os
        import time
        
        # WICHTIG: Stoppe alten Proxy zuerst!
        self._stopProxy()
        
        # Speichere URL für Seek-Requests
        self._proxyUpstreamUrl = upstream_url
        
        # Verwende übergebene Content-Length oder Fallback
        if content_length is None:
            content_length = 50 * 1024 * 1024
            print u"Using fallback content-length: %d bytes" % content_length
        
        # Berechne Dauer: 128kbps = 16000 bytes/sec
        self._streamDuration = int(content_length * 1000 / 16000)
        print u"Estimated duration: %d ms (%.1f min)" % (self._streamDuration, self._streamDuration/60000.0)
        
        # Cache-Verzeichnis in MyDocs (hat genug Platz, /tmp ist nur 4MB!)
        cache_dir = "/home/user/MyDocs/.oe1cache"
        if not os.path.exists(cache_dir):
            try:
                os.makedirs(cache_dir)
            except:
                cache_dir = "/home/user/MyDocs"
        
        # Lösche alte Cache-Dateien zuerst
        if os.path.exists(cache_dir):
            for f in os.listdir(cache_dir):
                if f.startswith('stream_') and f.endswith('.mp3'):
                    try:
                        os.remove(os.path.join(cache_dir, f))
                    except:
                        pass
        
        # Unique Temp-Datei mit Timestamp
        self._proxyTempFile = os.path.join(cache_dir, "stream_%d.mp3" % int(time.time()))
        
        # Starte Hintergrund-Download in Datei (ohne PIPE um Buffer-Blockade zu vermeiden)
        self._downloadProc = subprocess.Popen(
            ['/opt/wunderw/bin/wget', '-q', '-O', self._proxyTempFile, self._proxyUpstreamUrl],
            stdout=open('/dev/null', 'w'),
            stderr=open('/dev/null', 'w')
        )
        print u"Background download started to: %s" % self._proxyTempFile
        
        # KEINE Wartezeit hier - handle_client wartet auf Daten
        # Das macht die UI reaktionsfähig
        
        # Finde freien Port
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(('127.0.0.1', 0))
        port = sock.getsockname()[1]
        sock.listen(5)
        
        self._proxySocket = sock
        self._proxyRunning = True
        self._proxyContentLength = content_length
        
        def handle_client(client):
            """Handle client with server-side seeking"""
            try:
                # Lese HTTP Request
                request = ''
                try:
                    request = client.recv(4096)
                except:
                    pass
                
                # Parse Range Header
                range_start = 0
                if 'Range:' in request:
                    import re
                    match = re.search(r'Range:\s*bytes=(\d+)-', request)
                    if match:
                        range_start = int(match.group(1))
                        print u"Seek requested to: %d bytes" % range_start
                
                # Warte auf initiale Daten (falls noch nicht vorhanden)
                if range_start == 0:
                    for _ in range(50):  # Max 5 Sekunden
                        if os.path.exists(self._proxyTempFile):
                            size = os.path.getsize(self._proxyTempFile)
                            if size >= 100000:  # 100KB
                                print u"Initial buffer ready: %d bytes" % size
                                break
                        time.sleep(0.1)
                
                file_size = 0
                use_existing_file = False
                
                # Prüfe ob wir aus existierender Datei lesen können
                if os.path.exists(self._proxyTempFile):
                    file_size = os.path.getsize(self._proxyTempFile)
                    # Nutze existierende Datei nur wenn Position schon geladen
                    if file_size > range_start + 100000:
                        use_existing_file = True
                        print u"Using cached data (have %d bytes)" % file_size
                
                total_size = self._proxyContentLength or file_size
                
                if range_start > 0 and not use_existing_file:
                    # Seek zu Position die noch nicht geladen ist
                    # Starte neuen wget mit Range-Header
                    print u"Starting new download from position %d" % range_start
                    
                    # Temp-Datei für diesen Seek
                    seek_file = self._proxyTempFile + ".seek"
                    
                    # wget mit Range-Header (ohne PIPE)
                    seek_proc = subprocess.Popen(
                        ['/opt/wunderw/bin/wget', '-q', '-O', seek_file,
                         '--header=Range: bytes=%d-' % range_start,
                         self._proxyUpstreamUrl],
                        stdout=open('/dev/null', 'w'),
                        stderr=open('/dev/null', 'w')
                    )
                    
                    # Warte auf erste Daten
                    for _ in range(50):
                        time.sleep(0.2)
                        if os.path.exists(seek_file) and os.path.getsize(seek_file) > 50000:
                            break
                    
                    if not os.path.exists(seek_file):
                        print u"Seek file not created"
                        seek_proc.terminate()
                        return
                    
                    # HTTP Response Header (206 Partial Content)
                    header = "HTTP/1.1 206 Partial Content\r\n"
                    header += "Content-Type: audio/mpeg\r\n"
                    header += "Content-Length: %d\r\n" % (total_size - range_start)
                    header += "Content-Range: bytes %d-%d/%d\r\n" % (range_start, total_size - 1, total_size)
                    header += "Accept-Ranges: bytes\r\n"
                    header += "Connection: close\r\n\r\n"
                    
                    try:
                        client.sendall(header)
                    except:
                        seek_proc.terminate()
                        if os.path.exists(seek_file):
                            os.remove(seek_file)
                        return
                    
                    # Stream aus Seek-Datei
                    bytes_sent = 0
                    target = total_size - range_start
                    with open(seek_file, 'rb') as f:
                        while self._proxyRunning and bytes_sent < target:
                            # Warte auf Daten
                            sz = os.path.getsize(seek_file)
                            wait_count = 0
                            while sz <= bytes_sent and wait_count < 50:
                                if seek_proc.poll() is not None:
                                    break
                                time.sleep(0.1)
                                sz = os.path.getsize(seek_file)
                                wait_count += 1
                            
                            chunk = f.read(65536)
                            if chunk:
                                try:
                                    client.sendall(chunk)
                                    bytes_sent += len(chunk)
                                except:
                                    break
                            elif seek_proc.poll() is not None:
                                break
                            else:
                                time.sleep(0.1)
                    
                    print u"Seek stream sent %d bytes" % bytes_sent
                    seek_proc.terminate()
                    try:
                        os.remove(seek_file)
                    except:
                        pass
                    return
                
                # Normaler Stream ohne Seek oder aus Cache
                # HTTP Response Header
                if range_start > 0:
                    print u"Sending 206 response for cached seek to %d" % range_start
                    header = "HTTP/1.1 206 Partial Content\r\n"
                    header += "Content-Type: audio/mpeg\r\n"
                    header += "Content-Length: %d\r\n" % (total_size - range_start)
                    header += "Content-Range: bytes %d-%d/%d\r\n" % (range_start, total_size - 1, total_size)
                else:
                    header = "HTTP/1.1 200 OK\r\n"
                    header += "Content-Type: audio/mpeg\r\n"
                    header += "Content-Length: %d\r\n" % total_size
                
                header += "Accept-Ranges: bytes\r\n"
                header += "Connection: close\r\n\r\n"
                
                try:
                    client.sendall(header)
                    print u"Header sent successfully"
                except Exception as e:
                    print u"Error sending header: %s" % e
                    return
                
                # Stream aus Datei
                with open(self._proxyTempFile, 'rb') as f:
                    f.seek(range_start)
                    bytes_sent = 0
                    target = total_size - range_start
                    download_done = False
                    all_data_sent = False
                    print u"Starting to stream from pos %d, target %d bytes" % (range_start, target)
                    
                    while self._proxyRunning:
                        current_pos = range_start + bytes_sent
                        
                        # Prüfe ob Download fertig ist
                        if self._downloadProc and self._downloadProc.poll() is not None:
                            download_done = True
                        
                        # Warte auf mehr Daten wenn nötig
                        if not download_done:
                            file_size = os.path.getsize(self._proxyTempFile)
                            wait_count = 0
                            while self._proxyRunning and file_size <= current_pos and wait_count < 50:
                                time.sleep(0.1)
                                file_size = os.path.getsize(self._proxyTempFile)
                                if self._downloadProc and self._downloadProc.poll() is not None:
                                    download_done = True
                                    break
                                wait_count += 1
                        
                        chunk = f.read(65536)
                        if chunk:
                            try:
                                client.sendall(chunk)
                                bytes_sent += len(chunk)
                            except Exception as e:
                                print u"Send error after %d bytes: %s" % (bytes_sent, e)
                                break
                        else:
                            # Keine Daten mehr zu lesen
                            if download_done and not all_data_sent:
                                print u"All data sent: %d bytes, keeping connection open" % bytes_sent
                                all_data_sent = True
                            # Warte statt zu schließen - Player spielt weiter
                            time.sleep(0.5)
                    
                    print u"Stream ended, sent %d bytes total" % bytes_sent
                        
            except Exception as e:
                print u"Client error: %s" % e
                import traceback
                traceback.print_exc()
            finally:
                try:
                    client.close()
                except:
                    pass
        
        def proxy_thread():
            import select
            sock.setblocking(False)
            while self._proxyRunning:
                try:
                    ready, _, _ = select.select([sock], [], [], 0.5)
                    if ready:
                        client, _ = sock.accept()
                        t = threading.Thread(target=handle_client, args=(client,))
                        t.daemon = True
                        t.start()
                except:
                    pass
        
        t = threading.Thread(target=proxy_thread)
        t.daemon = True
        t.start()
        
        print u"Proxy started on port %d (file-backed)" % port
        return port
    
