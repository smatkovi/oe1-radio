    def _checkDownloadProgress(self):
        """Check download progress"""
        import os
        if not self._saveDownloadActive:
            self.downloadTimer.stop()
            return
        
        if self._saveDownloadProc and self._saveDownloadProc.poll() is not None:
            # Download fertig
            self._saveDownloadActive = False
            self.downloadTimer.stop()
            
            if os.path.exists(self._saveDownloadFile):
                size = os.path.getsize(self._saveDownloadFile)
                if size > 0:
                    self._saveDownloadProgress = 100
                    print u"Download complete: %s (%d bytes)" % (self._saveDownloadFile, size)
                    self.downloadFinished.emit()
                else:
                    print u"Download failed: empty file"
                    self._errorMsg = "Download fehlgeschlagen"
                    self.errorOccurred.emit()
            else:
                print u"Download failed: file not found"
                self._errorMsg = "Download fehlgeschlagen"
                self.errorOccurred.emit()
            
            self._saveDownloadProc = None
            self.downloadProgressChanged.emit()
            return
        
        # Progress berechnen
        if self._saveDownloadSize > 0 and os.path.exists(self._saveDownloadFile):
            current = os.path.getsize(self._saveDownloadFile)
            self._saveDownloadProgress = int(100 * current / self._saveDownloadSize)
            self.downloadProgressChanged.emit()
    
    @Slot(str, str)
    def downloadFile(self, url, filename):
        """Download file to MyDocs/Oe1 (without broadcast ID)"""
        self._downloadFileInternal(url, filename, 0)
    
    def downloadFileWithId(self, url, filename, broadcastId):
        """Download file to MyDocs/Oe1 with broadcast ID prefix"""
        self._downloadFileInternal(url, filename, broadcastId)
    
    def _downloadFileInternal(self, url, filename, broadcastId):
        """Download file to MyDocs/Oe1"""
        import os
        
        # Stoppe laufenden Download
        if self._saveDownloadActive:
            self.cancelDownload()
        
        # Erstelle Zielverzeichnis (Unicode!)
        download_dir = u"/home/user/MyDocs/Oe1"
        if not os.path.exists(download_dir):
            try:
                os.makedirs(download_dir)
            except:
                download_dir = u"/home/user/MyDocs"
        
        # Bereinige Dateinamen (als Unicode)
        if isinstance(filename, str):
            filename = filename.decode('utf-8', 'ignore')
        safe_name = filename.replace(u'/', u'-').replace(u':', u'-').replace(u'?', u'').replace(u'"', u'')
        # Ersetze Umlaute für sichereren Dateinamen
        safe_name = safe_name.replace(u'ä', u'ae').replace(u'ö', u'oe').replace(u'ü', u'ue')
        safe_name = safe_name.replace(u'Ä', u'Ae').replace(u'Ö', u'Oe').replace(u'Ü', u'Ue')
        safe_name = safe_name.replace(u'ß', u'ss')
        
        # Mit BroadcastID prefix wenn vorhanden
        if broadcastId > 0:
            safe_name = u"%d_%s" % (broadcastId, safe_name)
        
        if not safe_name.endswith(u'.mp3'):
            safe_name += u'.mp3'
        
        self._saveDownloadFile = os.path.join(download_dir, safe_name)
        
        print u"Starting download: %s" % self._saveDownloadFile
        
        # Hole Dateigröße
        self._saveDownloadSize = 0
        try:
            proc = subprocess.Popen(
                ['/opt/wunderw/bin/wget', '--spider', '-S', '--timeout=10', url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
            _, stderr = proc.communicate()
            for line in stderr.split('\n'):
                line_lower = line.lower()
                if 'content-length:' in line_lower:
                    parts = line.split(':')
                    if len(parts) > 1:
                        try:
                            self._saveDownloadSize = int(parts[1].strip().split()[0])
                        except:
                            pass
                        break
        except:
            pass
        
        # Starte Download
        self._saveDownloadProc = subprocess.Popen(
            ['/opt/wunderw/bin/wget', '-q', '-O', self._saveDownloadFile, url],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        
        self._saveDownloadActive = True
        self._saveDownloadProgress = 0
        self.downloadProgressChanged.emit()
        
        # Starte Progress-Timer
        self.downloadTimer.start(500)
    
    @Slot(int)
    def downloadBroadcast(self, broadcastId):
        """Download 7-Tage broadcast"""
        print u"Downloading broadcast: %d" % broadcastId
        
        def worker():
            try:
                # Hole Broadcast-Details (gleiche URL wie getPlaybackUrl)
                url = "%s/broadcast/%d" % (API_OE1, broadcastId)
                print u"Fetching broadcast info from: %s" % url
                data = self._fetchUrl(url)
                if data:
                    print u"Got broadcast data, length: %d" % len(data)
                    self._pending['downloadBroadcast'] = (broadcastId, data)
                else:
                    print u"No data returned from API"
                    self._pending['downloadBroadcast'] = None
            except Exception as e:
                print u"Download broadcast error: %s" % e
                self._pending['downloadBroadcast'] = None
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        def check():
            if 'downloadBroadcast' in self._pending:
                result = self._pending.pop('downloadBroadcast')
                if result:
                    broadcastId, data = result
                    self._handleDownloadBroadcast(broadcastId, data)
                else:
                    print u"Download check: no result"
                    self._errorMsg = "Keine Stream-Daten"
                    self.errorOccurred.emit()
            elif t.is_alive():
                QTimer.singleShot(200, check)
            else:
                print u"Download check: thread finished without result"
        
        QTimer.singleShot(200, check)
    
    def _handleDownloadBroadcast(self, broadcastId, data):
        """Parse stream info and start download"""
        try:
            print u"Parsing download data for broadcast %d" % broadcastId
            response = json.loads(data)
            payload = response.get('payload', {})
            if isinstance(payload, list) and len(payload) > 0:
                payload = payload[0]
            
            # Finde loopstream URL
            streams = payload.get('streams', [])
            mp3_url = None
            for s in streams:
                if isinstance(s, dict) and 'loopStreamId' in s:
                    loop_id = s.get('loopStreamId', '')
                    if loop_id:
                        # HTTP statt HTTPS (loopstream akzeptiert beides)
                        mp3_url = "https://loopstream01.apa.at/?channel=oe1&id=%s" % loop_id
                        print u"Found loopstream: %s" % loop_id
                        break
            
            if mp3_url:
                # Hole Titel aus Cache oder payload
                title = payload.get('title', '') or "oe1_broadcast_%d" % broadcastId
                print u"Starting download: %s -> %s" % (mp3_url[:50], title)
                self.downloadFileWithId(mp3_url, title, broadcastId)
            else:
                print u"No stream found in payload"
                self._errorMsg = "Kein Stream verfügbar"
                self.errorOccurred.emit()
                
        except Exception as e:
            print u"Handle download broadcast error: %s" % e
            import traceback
            traceback.print_exc()
            self._errorMsg = "Download-Fehler"
            self.errorOccurred.emit()
    
    @Slot(str, str)
    def downloadPodcastEpisode(self, url, title):
        """Download podcast episode"""
        print u"Downloading podcast: %s" % title
        
        # HTTPS zu HTTP (Server unterstützt beides)
        if url.startswith('https://'):
            url = url.replace('https://', 'http://')
        
        self.downloadFile(url, title)
    
    @Slot()
    def cancelDownload(self):
        """Cancel active download"""
        import os
        
        print u"cancelDownload called, active=%s" % self._saveDownloadActive
        
        if self._saveDownloadProc:
            try:
                self._saveDownloadProc.terminate()
                self._saveDownloadProc.wait()
            except:
                pass
            self._saveDownloadProc = None
        
        # Lösche unvollständige Datei
        if self._saveDownloadFile and os.path.exists(self._saveDownloadFile):
            try:
                os.remove(self._saveDownloadFile)
            except:
                pass
        
        self._saveDownloadActive = False
        self._saveDownloadProgress = 0
        self._saveDownloadFile = ''
        self.downloadTimer.stop()
        self.downloadProgressChanged.emit()
        print u"Download cancelled"
    
