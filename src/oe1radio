    @Slot()
    def loadOnDemandDays(self):
        """Generate list of last 7 days with correct field names"""
        days = []
        weekdays_de = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']
        
        for i in range(7):
            d = datetime.now() - timedelta(days=i)
            day = {
                'date': d.strftime('%Y%m%d'),
                # QML erwartet 'weekday' und 'displayDate'
                'weekday': 'Heute' if i == 0 else ('Gestern' if i == 1 else weekdays_de[d.weekday()]),
                'displayDate': d.strftime('%d.%m.')
            }
            days.append(day)
        
        self._daysJson = json.dumps(days)
        self.onDemandDaysChanged.emit()
    
