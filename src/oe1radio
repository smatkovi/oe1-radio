    @Slot(str)
    def startLiveProxy(self, liveUrl):
        """Start proxy for livestream with timeshift capability"""
        print u"Starting live proxy for: %s" % liveUrl
        
        # Stoppe alten Proxy
        self._stopProxy()
        
        # Setze streamDuration auf 0 (wird dynamisch in QML berechnet)
        self._streamDuration = 0
        
        # Starte Proxy für Livestream
        import socket
        import os
        import time
        
        # Cache-Verzeichnis in MyDocs (hat genug Platz, /tmp ist nur 4MB!)
        cache_dir = "/home/user/MyDocs/.oe1cache"
        if not os.path.exists(cache_dir):
            try:
                os.makedirs(cache_dir)
            except:
                cache_dir = "/home/user/MyDocs"
        
        # Lösche alte Live-Cache-Dateien
        for f in os.listdir(cache_dir):
            if f.startswith('live_') and f.endswith('.mp3'):
                try:
                    os.remove(os.path.join(cache_dir, f))
                except:
                    pass
        
        # Temp-Datei für Live-Cache
        self._proxyTempFile = os.path.join(cache_dir, "live_%d.mp3" % int(time.time()))
        
        # Starte Hintergrund-Download (läuft endlos für Livestream)
        self._downloadProc = subprocess.Popen(
            ['/opt/wunderw/bin/wget', '-q', '-O', self._proxyTempFile, liveUrl],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        print u"Live cache started: %s" % self._proxyTempFile
        
        # Kurze Wartezeit auf erste Daten (max 2 sec)
        for i in range(20):
            time.sleep(0.1)
            if os.path.exists(self._proxyTempFile):
                size = os.path.getsize(self._proxyTempFile)
                if size >= 100 * 1024:  # 100KB
                    print u"Live buffer ready: %d bytes" % size
                    break
        
        # Finde freien Port
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(('127.0.0.1', 0))
        port = sock.getsockname()[1]
        sock.listen(5)
        
        self._proxySocket = sock
        self._proxyRunning = True
        self._proxyContentLength = None  # Livestream hat keine feste Länge
        
        def handle_client(client):
            """Handle client for live streaming"""
            try:
                request = ''
                try:
                    request = client.recv(4096)
                except:
                    pass
                
                range_start = 0
                if 'Range:' in request:
                    import re
                    match = re.search(r'Range:\s*bytes=(\d+)-', request)
                    if match:
                        range_start = int(match.group(1))
                        print u"Live seek to: %d" % range_start
                
                # Warte bis Datei groß genug
                timeout = 100
                while timeout > 0 and self._proxyRunning:
                    if os.path.exists(self._proxyTempFile):
                        size = os.path.getsize(self._proxyTempFile)
                        if size > range_start + 50000:
                            break
                    time.sleep(0.05)
                    timeout -= 1
                
                if not os.path.exists(self._proxyTempFile):
                    return
                
                # HTTP Response ohne Content-Length (Chunked/Streaming)
                if range_start > 0:
                    header = "HTTP/1.1 206 Partial Content\r\n"
                else:
                    header = "HTTP/1.1 200 OK\r\n"
                header += "Content-Type: audio/mpeg\r\n"
                header += "Accept-Ranges: bytes\r\n"
                header += "Connection: close\r\n\r\n"
                client.sendall(header)
                
                # Stream aus Datei
                with open(self._proxyTempFile, 'rb') as f:
                    f.seek(range_start)
                    
                    while self._proxyRunning:
                        # Warte auf mehr Daten
                        wait_count = 0
                        current_pos = f.tell()
                        while self._proxyRunning and wait_count < 100:
                            file_size = os.path.getsize(self._proxyTempFile)
                            if file_size > current_pos + 1000:
                                break
                            time.sleep(0.05)
                            wait_count += 1
                        
                        chunk = f.read(32768)
                        if chunk:
                            try:
                                client.sendall(chunk)
                            except:
                                break
                        else:
                            time.sleep(0.05)
                        
            except Exception as e:
                print u"Live client error: %s" % e
            finally:
                try:
                    client.close()
                except:
                    pass
        
        def proxy_thread():
            import select
            sock.setblocking(False)
            while self._proxyRunning:
                try:
                    ready, _, _ = select.select([sock], [], [], 0.5)
                    if ready:
                        client, _ = sock.accept()
                        t = threading.Thread(target=handle_client, args=(client,))
                        t.daemon = True
                        t.start()
                except:
                    pass
        
        t = threading.Thread(target=proxy_thread)
        t.daemon = True
        t.start()
        
        print u"Live proxy on port %d" % port
        
        self._playUrl = "http://127.0.0.1:%d/stream.mp3" % port
        self.playUrlChanged.emit()
    
