    @Slot()
    def refreshCurrentShow(self):
        """Refresh current show info"""
        print u"Refreshing current show..."
        
        def worker():
            try:
                today = datetime.now().strftime('%Y%m%d')
                url = "%s/broadcasts/%s" % (API_OE1, today)
                data = self._fetchUrl(url)
                if data:
                    self._pending['currentShow'] = data
            except Exception as e:
                print u"Current show error: %s" % e
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        def check():
            if 'currentShow' in self._pending:
                data = self._pending.pop('currentShow')
                self._handleCurrentShow(data)
            elif t.is_alive():
                QTimer.singleShot(200, check)
        
        QTimer.singleShot(200, check)
    
    def _handleCurrentShow(self, data):
        """Parse current show"""
        try:
            response = json.loads(data)
            broadcasts = response.get('payload', [])
            now = datetime.utcnow()
            
            for b in broadcasts:
                try:
                    startStr = b.get('start', '')
                    endStr = b.get('end', '')
                    
                    if startStr and endStr:
                        start = datetime.strptime(startStr[:19], '%Y-%m-%dT%H:%M:%S')
                        end = datetime.strptime(endStr[:19], '%Y-%m-%dT%H:%M:%S')
                        
                        if start <= now <= end:
                            # Zeit auf CET umrechnen für Anzeige
                            startCET = start + timedelta(hours=1)
                            endCET = end + timedelta(hours=1)
                            
                            show = {
                                'id': b.get('id', 0),
                                'title': b.get('title', u'Ö1'),
                                'subtitle': b.get('programTitle', '') or '',
                                'startTime': startCET.strftime('%H:%M'),
                                'endTime': endCET.strftime('%H:%M')
                            }
                            self._showJson = json.dumps(show)
                            self._currentBroadcastId = b.get('id', 0)
                            self.currentShowChanged.emit()
                            return
                except:
                    continue
            
            show = {
                'id': 0,
                'title': u'Ö1 Livestream',
                'subtitle': datetime.now().strftime('%H:%M'),
                'startTime': '',
                'endTime': ''
            }
            self._showJson = json.dumps(show)
            self._currentBroadcastId = 0
            self.currentShowChanged.emit()
            
        except Exception as e:
            print u"Parse current show error: %s" % e
    
