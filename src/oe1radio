# --- Ausgabe immer in UTF-8 ------------------------------------------------
# Harmattans Startansicht gibt der App *kein* LANG mit, also ist
# sys.stdout.encoding None und Python nimmt ASCII. Jedes `print u"...Ö..."`
# wirft dann UnicodeEncodeError. Im Hauptfaden hat das die App eine Sekunde
# nach dem Antippen beendet; in den Arbeitsfaeden (Sendungstitel wie
# u"Ö1 Frühjournal") riss es still den Faden ab, bevor playUrl gesetzt war --
# daher ging weder Livestream noch 7-Tage. Einmal umhuellen deckt alle
# 107 print-Anweisungen und traceback.print_exc() ab.
class _Utf8Stream(object):
    """Schreibt unicode als UTF-8 weiter und laesst Bytes unangetastet."""

    def __init__(self, stream):
        self._stream = stream

    def write(self, data):
        if isinstance(data, unicode):
            data = data.encode('utf-8', 'replace')
        self._stream.write(data)

    def writelines(self, lines):
        for line in lines:
            self.write(line)

    def flush(self):
        self._stream.flush()

    def __getattr__(self, name):
        return getattr(self._stream, name)


if getattr(sys.stdout, 'encoding', None) is None:
    sys.stdout = _Utf8Stream(sys.stdout)
if getattr(sys.stderr, 'encoding', None) is None:
    sys.stderr = _Utf8Stream(sys.stderr)

