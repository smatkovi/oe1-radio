    def _handleSchedule(self, data):
        """Parse schedule"""
        try:
            response = json.loads(data)
            broadcasts = response.get('payload', [])
            now = datetime.utcnow()
            
            schedule = []
            for b in broadcasts:
                try:
                    startStr = b.get('start', '')
                    endStr = b.get('end', '')
                    if startStr:
                        start = datetime.strptime(startStr[:19], '%Y-%m-%dT%H:%M:%S')
                        start = start + timedelta(hours=1)  # UTC -> CET
                        
                        endTime = ''
                        if endStr:
                            end = datetime.strptime(endStr[:19], '%Y-%m-%dT%H:%M:%S')
                            end = end + timedelta(hours=1)
                            endTime = end.strftime('%H:%M')
                        
                        if start > now:
                            item = {
                                'id': b.get('id', 0),
                                'title': b.get('title', ''),
                                'subtitle': b.get('programTitle', '') or '',
                                'time': start.strftime('%H:%M'),
                                'endTime': endTime,
                                'isOnDemand': b.get('isOnDemand', False)
                            }
                            schedule.append(item)
                            
                            if len(schedule) >= 10:
                                break
                except:
                    continue
            
            self._scheduleJson = json.dumps(schedule)
            self.scheduleChanged.emit()
            
        except Exception as e:
            print u"Parse schedule error: %s" % e
    
