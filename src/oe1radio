    def _handleRssEpisodes(self, rss_data):
        """Parse podcast episodes from RSS feed - use HTTP for MP3s"""
        import re
        import os
        try:
            items = []
            download_dir = u"/home/user/MyDocs/Oe1"
            
            # Stelle sicher dass rss_data Unicode ist
            if isinstance(rss_data, str):
