    def _handleBroadcastInfo(self, data):
        """Parse broadcast details"""
        try:
            response = json.loads(data)
            
            # API kann payload wrapper haben oder direkt das Objekt sein
            if isinstance(response, dict):
                if 'payload' in response:
                    payload = response.get('payload', {})
                    # payload kann auch direkt das Objekt sein oder eine Liste
                    if isinstance(payload, list) and len(payload) > 0:
                        payload = payload[0]
                    elif not isinstance(payload, dict):
                        payload = response
                else:
                    payload = response
            else:
                print u"Unexpected response type: %s" % type(response)
                self._broadcastInfoJson = '{}'
                self.broadcastInfoChanged.emit()
                return
            
            # Basisinfos
            title = payload.get('title', '') if isinstance(payload, dict) else ''
            programTitle = ''
            if isinstance(payload, dict):
                programTitle = payload.get('programTitle', '')
                if not programTitle:
                    prog = payload.get('program', {})
                    if isinstance(prog, dict):
                        programTitle = prog.get('title', '')
            
            # Start/End Zeit
            startStr = payload.get('start', '') if isinstance(payload, dict) else ''
            endStr = payload.get('end', '') if isinstance(payload, dict) else ''
            startTime = ''
            endTime = ''
            if startStr:
                start = datetime.strptime(startStr[:19], '%Y-%m-%dT%H:%M:%S')
                start = start + timedelta(hours=1)  # UTC -> CET
                startTime = start.strftime('%H:%M')
            if endStr:
                end = datetime.strptime(endStr[:19], '%Y-%m-%dT%H:%M:%S')
                end = end + timedelta(hours=1)
                endTime = end.strftime('%H:%M')
            
            # Beschreibung
            description = ''
            if isinstance(payload, dict):
                description = payload.get('description', '') or payload.get('subtitle', '') or ''
            
            # Moderator/Presenter
            moderator = ''
            if isinstance(payload, dict):
                presenters = payload.get('presenters', [])
                if isinstance(presenters, list):
                    names = []
                    for p in presenters:
                        if isinstance(p, dict) and p.get('name'):
                            names.append(p.get('name'))
                    moderator = ', '.join(names)
            
            # Themen/Items
            topics = []
            if isinstance(payload, dict):
                items = payload.get('items', [])
                if isinstance(items, list):
                    for item in items[:10]:
                        if isinstance(item, dict):
                            itemTitle = item.get('title', '')
                            if itemTitle:
                                topics.append(itemTitle)
            
            # hasStream Check
            hasStream = False
            if isinstance(payload, dict):
                streams = payload.get('streams', [])
                hasStream = isinstance(streams, list) and len(streams) > 0
            
            info = {
                'title': title,
                'programTitle': programTitle,
                'startTime': startTime,
                'endTime': endTime,
                'description': description,
                'moderator': moderator,
                'topics': topics,
                'hasStream': hasStream
            }
            
            print u"Broadcast info loaded: %s" % title
            self._broadcastInfoJson = json.dumps(info)
            self.broadcastInfoChanged.emit()
            
        except Exception as e:
            print u"Parse broadcast info error: %s" % e
            self._broadcastInfoJson = '{}'
            self.broadcastInfoChanged.emit()
    
