    def _fetchUrl(self, url):
        """Fetch URL using wget from wunderw (SSL support)"""
        try:
            # Verwende wunderw wget mit modernem SSL
            wget_path = '/opt/wunderw/bin/wget'
            proc = subprocess.Popen(
                [wget_path, '-q', '-O', '-', '--timeout=15', url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
            stdout, stderr = proc.communicate()
            return stdout
        except Exception as e:
            print u"Fetch error: %s" % e
            return None
    
